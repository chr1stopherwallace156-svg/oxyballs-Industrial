+// MARK: - Thermal / resource adaptive policy (Sprint 3.7)
+
+public enum ThermalState: String, Codable, Sendable, Equatable {
+  case nominal = "NOMINAL"
+  case fair = "FAIR"
+  case serious = "SERIOUS"
+  case critical = "CRITICAL"
