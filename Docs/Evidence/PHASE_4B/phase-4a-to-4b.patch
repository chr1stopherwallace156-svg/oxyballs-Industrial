+    sampleIndex.sort { (($0["relative_path"] as? String) ?? "") < (($1["relative_path"] as? String) ?? "") }
+    try writeJSON(["samples": sampleIndex], to: outputDirectory.appendingPathComponent("sample_index.json"))
+
+    let manifest = SpatialEvidenceManifest(
+      packageID: Self.primaryPackageID,
+      vehicleID: "VEH-FIXTURE-RECONSTRUCTION-MULTIFRAME-000001",
+      captureSessionID: Self.primarySessionID,
+      pilotID: "PILOT-FIXTURE-000001",
+      createdAtUTC: "2026-08-04T05:00:00Z",
+      capability: capability,
+      frames: frames,
+      clockCorrelations: correlations,
+      artifacts: artifacts,
+      sampleIndex: sampleIndex
+    )
+    var manifestDict = manifest.asDictionary()
+    manifestDict["schema_id"] = "SpatialEvidenceManifest"
+    manifestDict["schema_version"] = "1.0.0-phase4b-fixture"
+    manifestDict["package_layout"] = "fixture_reconstruction_multiframe_v1"
