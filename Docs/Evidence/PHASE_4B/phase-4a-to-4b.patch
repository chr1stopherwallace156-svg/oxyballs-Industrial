+  private func decodeTransform(_ bytes: Data) -> [Double] {
+    var matrix: [Double] = []
+    let count = min(16, bytes.count / 8)
+    for i in 0..<count {
+      let o = i * 8
+      var bits: UInt64 = 0
+      for b in 0..<8 { bits |= UInt64(bytes[o + b]) << (8 * b) }
+      matrix.append(Double(bitPattern: bits))
+    }
+    while matrix.count < 16 { matrix.append(0) }
+    return matrix
+  }
