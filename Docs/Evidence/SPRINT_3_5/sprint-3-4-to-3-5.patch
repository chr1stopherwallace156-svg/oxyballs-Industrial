+        "relative_path": rel,
+        "sha256": ContentHasher.sha256Hex(data),
+        "byte_length": data.count,
+        "media_type": "application/json",
+        "schema_id": "DerivedEvidence",
+        "schema_version": "1.0.0-phase3-fixture",
