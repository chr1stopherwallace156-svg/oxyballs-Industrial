{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elektron.local/schemas/Phase4ECharacterizationReport.v1.0.0.schema.json",
  "title": "Phase 4E Characterization Report",
  "description": "Evaluation of an IMMUTABLE Phase 4D geometry against declared engineering uses. Phase 4E is a characterization/measurement-authority layer; it never mutates geometry and never asserts engineering metrology until physical validation is recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase_4e_schema_version",
    "schema_id",
    "source_phase_4d",
    "declared_operating_envelope",
    "authority_state",
    "global_scale_status",
    "determinism",
    "claim_locks",
    "engineering_use_authority",
    "measurements",
    "region_dispositions"
  ],
  "properties": {
    "schema_id": { "const": "Phase4ECharacterizationReport" },
    "phase_4e_schema_version": { "type": "string", "pattern": "^1\\.0\\.0" },

    "source_phase_4d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_schema_id", "output_closure_sha256", "phase4e_readiness"],
      "properties": {
        "handoff_schema_id": { "const": "Phase4DHandoffContract" },
        "handoff_schema_version": { "type": "string" },
        "output_closure_sha256": { "type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$" },
        "source_lineage_manifest_id": { "type": "string" },
        "phase4e_readiness": { "type": "string", "enum": ["READY_WITH_UNRESOLVED_BOUNDARIES", "READY"] },
        "reconstruction_coordinate_convention": { "type": "object" }
      }
    },

    "declared_operating_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_model", "depth_engine_version", "working_distance_range_meters"],
      "properties": {
        "device_model": { "type": "string" },
        "depth_engine_version": { "type": "string" },
        "working_distance_range_meters": {
          "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
        },
        "ambient_lux_range": {
          "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
        }
      }
    },

    "authority_state": { "type": "string", "enum": ["UNCONTROLLED", "SCALE_ONLY", "CONTROL_COMPARED", "CONTROL_VERIFIED"] },

    "global_scale_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["UNSCALED", "SCALE_ESTIMATED", "SCALE_ANCHORED", "SCALE_VERIFIED"] },
        "method": { "type": "string" },
        "scale_error_ppm": { "type": "number" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" }
      }
    },

    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_pipeline_determinism", "physical_reproducibility"],
      "properties": {
        "software_pipeline_determinism": { "type": "string", "enum": ["VERIFIED", "UNVERIFIED", "NOT_APPLICABLE"] },
        "physical_reproducibility": { "type": "string", "enum": ["UNVERIFIED", "IN_PROGRESS", "VERIFIED"] }
      }
    },

    "engineering_use_authority": { "type": "string", "enum": ["FORBIDDEN", "FIXTURE_ONLY", "AUTHORIZED"] },

    "claim_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineering_metrology_claim",
        "production_vehicle_mesh_claim",
        "manufacturing_geometry_claim",
        "complete_digital_twin_claim"
      ],
      "properties": {
        "engineering_metrology_claim": { "type": "string", "enum": ["FORBIDDEN", "AUTHORIZED"] },
        "production_vehicle_mesh_claim": { "type": "string", "enum": ["FORBIDDEN", "AUTHORIZED"] },
        "manufacturing_geometry_claim": { "type": "string", "enum": ["FORBIDDEN", "AUTHORIZED"] },
        "complete_digital_twin_claim": { "type": "string", "enum": ["FORBIDDEN", "AUTHORIZED"] },
        "physical_validation_evidence_id": { "type": ["string", "null"] }
      }
    },

    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measurement_id", "value_mm", "measurement_basis", "uncertainty", "use_evaluations"],
        "properties": {
          "measurement_id": { "type": "string" },
          "label": { "type": "string" },
          "value_mm": { "type": "number" },
          "measurement_basis": { "type": "string", "enum": ["SCAN_ONLY", "COMBINED_SCAN_AND_PHYSICAL_CONTROL", "PHYSICAL_CONTROL_ONLY"] },
          "uncertainty": { "$ref": "#/$defs/uncertainty" },
          "use_evaluations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["declared_use", "tolerance_budget_mm", "decision_rule", "guard_band_mm", "disposition", "reason_codes"],
              "properties": {
                "declared_use": { "type": "string" },
                "tolerance_budget_mm": { "type": "number" },
                "decision_rule": { "type": "string", "enum": ["SIMPLE_ACCEPTANCE", "GUARDED_ACCEPTANCE", "GUARDED_REJECTION"] },
                "guard_band_mm": { "type": "number", "minimum": 0 },
                "disposition": { "type": "string", "enum": ["ACCEPTABLE", "PROVISIONAL", "UNSUITABLE", "INDETERMINATE"] },
                "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          }
        }
      }
    },

    "region_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "disposition", "reason_codes"],
        "properties": {
          "region_id": { "type": "string" },
          "disposition": { "type": "string", "enum": ["ACCEPTABLE", "PROVISIONAL", "UNSUITABLE", "INDETERMINATE"] },
          "reason_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "recapture_contract_id": { "type": ["string", "null"] }
        }
      }
    }
  },

  "$defs": {
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expanded_uncertainty_mm", "coverage_factor_k"],
      "properties": {
        "standard_uncertainty_mm": { "type": "number", "minimum": 0 },
        "expanded_uncertainty_mm": { "type": "number", "minimum": 0 },
        "coverage_factor_k": { "type": "number", "exclusiveMinimum": 0 },
        "confidence_level_pct": { "type": "number" },
        "budget_components": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
