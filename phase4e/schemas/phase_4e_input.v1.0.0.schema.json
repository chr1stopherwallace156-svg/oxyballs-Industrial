{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase4EInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","source_phase_4d","device","declared_operating_envelope","scale_anchors","datums","physical_controls","manual_measurements"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "source_phase_4d": {
      "type": "object", "additionalProperties": false,
      "required": ["surface_id","canonical_mesh_sha256","phase_4d_output_closure_sha256","phase_4d_algorithm_id","phase_4d_configuration_digest"],
      "properties": {
        "surface_id": { "type": "string" },
        "canonical_mesh_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "phase_4d_output_closure_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "phase_4d_algorithm_id": { "type": "string" },
        "phase_4d_configuration_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["manufacturer","model_identifier","marketing_name","os_version","sensor_profile_id","calibration_profile_id"],
      "properties": {
        "manufacturer": {"type":"string"}, "model_identifier": {"type":"string"}, "marketing_name": {"type":"string"},
        "os_version": {"type":"string"}, "sensor_profile_id": {"type":"string"}, "calibration_profile_id": {"type":"string"}
      }
    },
    "declared_operating_envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id","working_distance_range_meters","ambient_lux_range","max_incidence_angle_deg"],
      "properties": {
        "envelope_id": {"type":"string"},
        "working_distance_range_meters": {"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
        "ambient_lux_range": {"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
        "max_incidence_angle_deg": {"type":"number"}
      }
    },
    "scale_anchors": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["anchor_id","anchor_type"],
        "properties": {
          "anchor_id": {"type":"string"},
          "anchor_type": {"type":"string","enum":["CALIBRATION_BAR","DISTRIBUTED_TARGET_ARRAY","INTRINSIC_SENSOR_SCALE"]},
          "calibration_certificate_id": {"type":"string"},
          "calibration_state": {"type":"string","enum":["VALID","EXPIRED","DAMAGED","UNVERIFIED"]},
          "valid_from": {"type":"string","format":"date-time"},
          "valid_until": {"type":"string","format":"date-time"},
          "issuing_authority": {"type":"string"},
          "artifact_serial_number": {"type":"string"},
          "sensor_profile_id": {"type":"string"},
          "device_calibration_state": {"type":"string"},
          "nominal_features": {"type":"array","items":{"type":"object","additionalProperties":false,
            "required":["feature_id","position_mm","standard_uncertainty_mm"],
            "properties":{"feature_id":{"type":"string"},
              "position_mm":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3},
              "standard_uncertainty_mm":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3}}}},
          "observed_correspondences": {"type":"array","items":{"type":"object","additionalProperties":false,
            "required":["nominal_feature_id","observed_point_id"],
            "properties":{"nominal_feature_id":{"type":"string"},"observed_point_id":{"type":"string"}}}}
        },
        "allOf": [
          { "if": { "properties": { "anchor_type": { "const": "INTRINSIC_SENSOR_SCALE" } } },
            "then": { "required": ["sensor_profile_id","device_calibration_state"] },
            "else": { "required": ["calibration_certificate_id","valid_from","valid_until","calibration_state"] } }
        ]
      }
    },
    "datums": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["datum_id","datum_type","source_frame_id","target_frame_id","handedness","origin_definition","axis_definition","reference_features"],
        "properties": {
          "datum_id": {"type":"string"},
          "datum_type": {"type":"string","enum":["PRIMARY_PLANE","THREE_POINT_BASE","FEATURE_ALIGNMENT","NOMINAL_CAD_OVERLAY"]},
          "source_frame_id": {"type":"string"}, "target_frame_id": {"type":"string"},
          "handedness": {"type":"string","enum":["RIGHT_HANDED","LEFT_HANDED"]},
          "origin_definition": {"type":"string"},
          "axis_definition": {"type":"object","additionalProperties":false,
            "required":["x_positive","y_positive","z_positive"],
            "properties":{"x_positive":{"type":"string"},"y_positive":{"type":"string"},"z_positive":{"type":"string"}}},
          "reference_features": {"type":"array","items":{"type":"string"}}
        }
      }
    },
    "physical_controls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control_id","feature_a_id","feature_b_id","reference_value_mm","standard_uncertainty_mm","instrument_id","instrument_calibration_id","procedure_id","operator_id","measured_at","use_role"],
        "properties": {
          "control_id": {"type":"string"}, "feature_a_id": {"type":"string"}, "feature_b_id": {"type":"string"},
          "reference_value_mm": {"type":"number"}, "standard_uncertainty_mm": {"type":"number"},
          "instrument_id": {"type":"string"}, "instrument_calibration_id": {"type":"string"},
          "procedure_id": {"type":"string"}, "operator_id": {"type":"string"},
          "measured_at": {"type":"string","format":"date-time"},
          "use_role": {"type":"string","enum":["FITTING_ONLY","VALIDATION_ONLY","EXCLUDED"]}
        }
      }
    },
    "manual_measurements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["measurement_id","feature_a_id","feature_b_id","region_id","value_mm","tool_type","tool_uncertainty_mm","uncertainty_interpretation","instrument_id","operator_id","measured_at"],
        "properties": {
          "measurement_id": {"type":"string"}, "feature_a_id": {"type":"string"}, "feature_b_id": {"type":"string"},
          "region_id": {"type":"string"}, "value_mm": {"type":"number"},
          "tool_type": {"type":"string","enum":["VERNIER_CALIPER","LASER_DISTANCE_METER","CMM_TOUCH_PROBE"]},
          "tool_uncertainty_mm": {"type":"number"},
          "uncertainty_interpretation": {"type":"string","enum":["STANDARD_UNCERTAINTY","EXPANDED_UNCERTAINTY","MANUFACTURER_ACCURACY_LIMIT","RESOLUTION_ONLY"]},
          "instrument_id": {"type":"string"}, "operator_id": {"type":"string"}, "measured_at": {"type":"string","format":"date-time"}
        }
      }
    }
  }
}
