  "decision_rule": ["SIMPLE_ACCEPTANCE", "GUARDED_ACCEPTANCE", "GUARDED_REJECTION"],
  "declared_use": [
    "BATTERY_ENCLOSURE_PACKAGING",
    "WIRE_HARNESS_ROUTING",
