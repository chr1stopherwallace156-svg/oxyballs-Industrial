{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elektron.local/schemas/RecaptureContract.v1.0.0.schema.json",
  "title": "Phase 4E Recapture Contract",
  "description": "A structured, machine-readable directive to re-capture a specific region so an unresolved/provisional Phase 4E evaluation can be closed. Active capture direction, not a passive error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recapture_contract_schema_version",
    "schema_id",
    "recapture_contract_id",
    "target_region_id",
    "affected_measurement_ids",
    "capture_guidance",
    "closure_criteria",
    "prior_evidence_retention"
  ],
  "properties": {
    "schema_id": { "const": "RecaptureContract" },
    "recapture_contract_schema_version": { "type": "string", "pattern": "^1\\.0\\.0" },
    "recapture_contract_id": { "type": "string" },
    "supersedes": { "type": ["string", "null"] },
    "target_region_id": { "type": "string" },
    "affected_measurement_ids": { "type": "array", "items": { "type": "string" } },
    "capture_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distance_range_meters", "required_view_angles"],
      "properties": {
        "required_anchor_visibility": { "type": "array", "items": { "type": "string" } },
        "required_control_points": { "type": "array", "items": { "type": "string" } },
        "distance_range_meters": {
          "type": "object", "additionalProperties": false,
          "required": ["min", "max"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        },
        "required_view_angles": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "count"],
            "properties": {
              "type": { "type": "string", "enum": ["NEAR_NORMAL", "OBLIQUE_UNDERSIDE", "OBLIQUE_TOPSIDE", "GRAZING"] },
              "min_angle_deg": { "type": "number" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "closure_criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_threshold_pct", "max_control_residual_mm", "max_repeated_spread_mm"],
      "properties": {
        "coverage_threshold_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "max_control_residual_mm": { "type": "number", "minimum": 0 },
        "max_repeated_spread_mm": { "type": "number", "minimum": 0 }
      }
    },
    "prior_evidence_retention": {
      "type": "string",
      "enum": ["USABLE_FOR_COARSE_ALIGNMENT", "DISCARD", "RETAIN_REFERENCE_ONLY"]
    },
    "closure_result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "closed": { "type": "boolean" },
        "closed_by_recapture_output_id": { "type": ["string", "null"] },
        "achieved_coverage_pct": { "type": ["number", "null"] }
      }
    }
  }
}
